    "/api/admin/products": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "فهرست همه محصولات برای پنل مدیریت",
        "security": [
          {
            "AdminKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "فهرست محصولات",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number"
                      },
                      "imageUrl": {
                        "type": "string"
                      },
                      "stock": {
                        "type": "integer"
                      },
                      "categoryId": {
                        "type": "integer"
